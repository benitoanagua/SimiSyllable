{
  "name": "handheld-design-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "node tooling/lint/design-rules.mjs && turbo lint",
    "storybook": "pnpm --filter @handheld/storybook storybook",
    "build:storybook": "pnpm --filter @handheld/storybook build-storybook",
    "showcase": "pnpm --filter @handheld/showcase dev",
    "build:showcase": "pnpm --filter @handheld/showcase build",
    "test:showcase": "pnpm --filter @handheld/showcase test",
    "test:visual": "pnpm --filter @handheld/testing test:visual",
    "test:visual:update": "pnpm --filter @handheld/testing test:visual -- --update-snapshots",
    "check": "pnpm check:icons && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:storybook",
    "release": "changeset publish",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:icons": "node tooling/validation/no-legacy-icons.mjs",
    "test:contracts": "pnpm --filter @handheld/testing test:contracts",
    "test:a11y": "pnpm --filter @handheld/testing test:a11y",
    "format:repair": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.55.0",
    "@stencil/core": "^4.38.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "storybook": "^8.6.18",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
