{
  "name": "simi-syllable",
  "version": "1.0.0",
  "type": "module",
  "description": "Lightweight and accurate JavaScript/TypeScript library for counting and dividing syllables in English and Spanish",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benitoanagua/SimiSyllable.git"
  },
  "homepage": "https://github.com/benitoanagua/SimiSyllable#readme",
  "bugs": {
    "url": "https://github.com/benitoanagua/SimiSyllable/issues"
  },
  "keywords": [
    "syllable",
    "counter",
    "divider",
    "english",
    "spanish",
    "linguistics",
    "phonetic",
    "typescript",
    "javascript",
    "hiatus",
    "diphthong",
    "triphthong",
    "multilingual"
  ],
  "author": "benitoanagua <benito.anagua@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
